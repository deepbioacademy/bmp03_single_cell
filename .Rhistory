VlnPlot(seu, "tcell_genes1")
# Annotating cells according to cycling phase
cc.genes
cc.genes.updated.2019$s.genes
cc.genes.updated.2020$s.genes
cc.genes.updated.2019$s.genes
cc.genes.updated.2019$g2m.genes
cc.genes
cc.genes.updated.2019$s.genes
cc.genes.updated.2019$g2m.genes
s_genes <- cc.genes.updated.2019$s.genes
g2m_genes <- cc.genes.updated.2019$g2m.genes
seu <- CellCycleScoring(
seu,
s.features = s_genes,
g2m.features = g2m_genes
)
head(seu@meta.data)
DimPlot(seu, group.by = "Phase")
